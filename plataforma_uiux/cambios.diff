+}
+/* ---------- móvil ---------- */
+@media (max-width: 720px) {
+  .sim-view { --sv-pad: 16px; }
+  body.mqp-sesion { padding-bottom: 0; }
+  .sim-view__bar { flex-wrap: nowrap; gap: 6px; }
+  .sim-view__back { flex: none; width: 44px; height: 40px; min-height: 40px; margin-left: -8px; padding: 0; justify-content: center; font-size: 1.1rem; }
+  .sim-view__back-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  .sim-view__back.is-armed { width: auto; padding: 0 10px; font-size: .8rem; white-space: normal; }
+  .sim-view__head { flex: 1 1 auto; gap: 8px; }
+  .sim-view__head .badge { display: none; }
+  .sim-view__score { display: none; }
+  .sim-view__bar .flag-count { display: none; }
+  .sim-view__bar #svFinish { padding: 0 12px; }
+  .sim-view__finish-extra { display: none; }
+  .sim-view__bar #svFinish.is-armed { white-space: normal; line-height: 1.2; font-size: .8rem; }
+  .sim-view__tutor-label { display: none; }
+
+  .quiz { border-radius: var(--radius); }
+  .quiz__head { padding-top: 16px; gap: 8px 12px; }
+  .quiz__progress { flex-basis: 64px; }
+  .switch--compact .switch__text, .flag-btn__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  .fav-btn, .flag-btn, .switch--compact { height: 40px; min-width: 40px; }
+  .pace__time { padding: 0 4px; }
+  .quiz__body { padding: 16px var(--sv-pad) 0; }
+  .quiz__options { margin-top: 20px; }
+  .opt { padding: 12px; gap: 10px; }
+  .opt-strike { width: 40px; opacity: 1; }
+  /* en móvil el estado baja bajo el texto para no estrecharlo */
+  .opt { flex-wrap: wrap; }
+  .opt__text { flex: 1 1 calc(100% - 38px); }
+  .opt__status { order: 3; margin: 2px 0 0 38px; }
+  .fb { margin-top: 24px; padding-top: 20px; }
+  .fb__section, .fb__pearl { margin-top: 24px; }
+  .reasoning__head { align-items: center; }
+  .reasoning__frame { padding: 4px; }
+
+  /* navegación fija abajo, al alcance del pulgar */
+  .sim-view__nav {
+    position: sticky; bottom: 0; z-index: 4; margin: 24px calc(-1 * var(--sv-pad)) 0; padding: 12px var(--sv-pad) calc(12px + env(safe-area-inset-bottom, 0px));
+    background: color-mix(in srgb, var(--surface) 94%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
+    border-top: 1px solid var(--line);
+  }
+  .sim-view__nav #svPrev { flex: none; }
+  .sim-view__nav #svNext { flex: 1; min-width: 0; }
+
+  /* visor a pantalla completa: el flujograma usa todo el ancho disponible */
+  .algo-modal, .algo-modal.algo-modal--visor {
+    width: 100vw; max-width: 100vw; height: 100vh; height: 100dvh; max-height: none; margin: 0; inset: 0;
+    border: 0; border-radius: 0;
+  }
+  .algo-modal__head { padding: 10px 12px 10px 16px; padding-top: calc(10px + env(safe-area-inset-top, 0px)); }
+  .algo-modal__head .kicker { display: none; }
+  .algo-modal__title { margin-top: 0; font-size: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+  .algo-modal__close { width: 44px; height: 44px; }
+  .algo-modal__body, .algo-modal--visor .algo-modal__body { flex: 1; padding: 10px 8px calc(12px + env(safe-area-inset-bottom, 0px)); }
+  .algo-zoom__bar { flex-wrap: nowrap; padding-inline: 4px; }
+  .algo-zoom__hint { font-size: .72rem; line-height: 1.35; }
+  .reasoning__title { font-size: .9375rem; }
+  .algo-zoom__frame { border-radius: var(--radius-sm); }
+  .algo-zoom__btn { width: 40px; height: 40px; }
+}
+@media (max-width: 480px) {
+  .algo-zoom__hint { display: none; }
+}
+@media (max-width: 380px) {
+  .quiz__progress { display: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .fb:not([hidden]), .algo-modal[open] { animation: none; }
+  .pace__fill, .quiz__progress-fill, .algo-zoom__stage.is-animating { transition: none; }
+}
