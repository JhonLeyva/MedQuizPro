+.sim-map__legend .is-current::before { border: 2px solid var(--brand); }
+
+/* ---------- atajos de teclado (solo con ratón y pantalla amplia) ---------- */
+.kbd-hints { display: none; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px; font-size: .78rem; color: var(--ink-3); }
+.kbd-hints span { display: inline-flex; align-items: center; gap: 4px; }
+@media (hover: hover) and (min-width: 900px) { .kbd-hints:not([hidden]) { display: flex; } }
+kbd {
+  display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 6px; border-radius: var(--radius-xs);
+  border: 1px solid var(--line-strong); border-bottom-width: 2px; background: var(--surface);
+  font-family: var(--f-body); font-size: .72rem; font-weight: 600; color: var(--ink-2);
+}
+
+/* ---------- visor de flujogramas e imágenes clínicas ---------- */
+.algo-modal {
+  width: min(720px, calc(100vw - 32px)); max-height: min(88vh, 800px); padding: 0; overflow: hidden;
+  border: 1px solid var(--line); border-radius: var(--radius-xl); background: var(--surface); color: var(--ink);
+  box-shadow: 0 32px 64px -24px rgba(15, 23, 42, .45);
+}
+.algo-modal[open] { display: flex; flex-direction: column; animation: modalIn var(--dur-slow) var(--ease); }
+.algo-modal::backdrop { background: rgba(15, 23, 42, .55); }
+@keyframes modalIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+.algo-modal__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 16px 20px; border-bottom: 1px solid var(--line); }
+.algo-modal__head .kicker { font-size: .72rem; }
+.algo-modal__title { margin-top: 4px; font-size: 1.125rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.35; }
+.algo-modal__sub { margin-top: 2px; font-size: .8125rem; color: var(--ink-3); }
+.algo-modal__close { flex: none; width: 40px; height: 40px; }
+.algo-modal__body { padding: 16px 20px 20px; overflow-y: auto; overscroll-behavior: contain; }
+.algo-modal__img { display: block; width: 100%; height: auto; }
+.algo-modal__note { margin-top: 16px; padding: 12px 14px; border-radius: var(--radius-md); background: var(--brand-tint); border: 1px solid color-mix(in srgb, var(--brand) 18%, transparent); font-size: .9rem; line-height: 1.55; color: var(--ink-2); }
+.algo-empty .algo-modal__note { background: var(--surface-2); border-color: var(--line); color: var(--ink-3); }
+
+.algo-modal.algo-modal--visor { width: min(1080px, calc(100vw - 32px)); max-height: min(94vh, 1000px); }
+.algo-modal--visor .algo-modal__body { padding: 12px 20px 20px; }
+.algo-zoom__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 10px; }
+.algo-zoom__tools { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
+.algo-zoom__btn {
+  display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: var(--radius-sm);
+  background: transparent; color: var(--ink-2); cursor: pointer; transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
+}
+.algo-zoom__btn svg { width: 18px; height: 18px; }
+.algo-zoom__btn:hover:not(:disabled) { background: var(--surface-2); color: var(--brand-strong); }
+.algo-zoom__btn:focus-visible { outline: none; box-shadow: var(--ring); }
+.algo-zoom__btn:disabled { opacity: .35; cursor: default; }
+.algo-zoom__level { min-width: 46px; text-align: center; font-size: .75rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink-3); }
+.algo-zoom__hint { font-size: .78rem; color: var(--ink-3); }
+.algo-zoom__frame {
+  position: relative; overflow: hidden; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: #fff;
+  touch-action: none; cursor: zoom-in; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
+}
+.algo-zoom.is-zoomed .algo-zoom__frame { cursor: grab; }
+.algo-zoom.is-dragging .algo-zoom__frame { cursor: grabbing; }
+.algo-zoom__stage { transform-origin: 0 0; }
+.algo-zoom__stage.is-animating { transition: transform var(--dur-slow) var(--ease); }
+.algo-zoom .algo-modal__img { pointer-events: none; -webkit-user-drag: none; }
+@media (hover: none) {
+  .algo-zoom__hint { font-size: 0; }
+  .algo-zoom__hint::before { content: "Pellizca para ampliar · arrastra para moverte"; font-size: .78rem; }
+}
+
+/* flujograma dibujado en HTML (preguntas sin imagen) */
+.flow-chart { list-style: none; margin: 0; padding: 0; display: grid; justify-items: center; gap: 26px; }
+.flow-chart__node {
+  position: relative; width: min(100%, 440px); padding: 12px 16px; text-align: center;
+  border-radius: var(--radius-md); border: 1px solid var(--line-strong); background: var(--surface); font-size: .92rem; font-weight: 600; line-height: 1.45; color: var(--ink);
+}
+.flow-chart__node + .flow-chart__node::before { content: ""; position: absolute; left: 50%; top: -26px; width: 2px; height: 20px; background: var(--line-strong); transform: translateX(-50%); }
+.flow-chart__node + .flow-chart__node::after { content: ""; position: absolute; left: 50%; top: -9px; border: 5px solid transparent; border-top-color: var(--line-strong); transform: translateX(-50%); }
+.flow-chart__node--inicio { background: var(--brand-soft); border-color: transparent; color: var(--brand-strong); }
+.flow-chart__node--decision { border-style: dashed; border-color: var(--mark); background: var(--mark-soft); color: var(--ink); }
+.flow-chart__node--fin { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
+
+/* ---------- sesión en curso: nada flota sobre la pregunta ---------- */
+body.mqp-sesion .mobile-cta { display: none; }
+
+/* ---------- tablet ---------- */
+@media (max-width: 960px) {
+  .sim-view { --sv-pad: 24px; }
