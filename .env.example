# Variables de entorno del chatbot de MedQuizPro.
# Es la forma recomendada de guardar la llave: nunca llega al navegador.
# En Hostinger: hPanel → Sitios web → Avanzado → Variables de entorno.
# En cPanel/Plesk, Docker o un VPS: define estas mismas variables en el entorno de PHP.

# Obligatoria: la llave de tu proveedor de IA.
AI_API_KEY=

# gemini (por defecto) | openai | anthropic
AI_PROVIDER=gemini

# Opcional. Con Gemini, déjalo vacío y el servidor elige el modelo disponible.
# Ejemplos: gemini-2.5-flash | gpt-4o-mini | claude-opus-5
AI_MODEL=

# Opcional. Solo para APIs compatibles con OpenAI (Groq, DeepSeek, OpenRouter…).
# Ejemplo: https://api.groq.com/openai/v1
AI_BASE_URL=

# Opcional. Límite de uso por visitante (por IP).
AI_LIMITE_MINUTO=10
AI_LIMITE_DIA=150

# Opcional. Palabra secreta para /api.php?accion=diagnostico&token=...
AI_DIAGNOSTICO_TOKEN=

# Opcional. 1 = el detalle técnico del error viaja también al navegador (solo para depurar).
AI_DEBUG=0
