# MedQuizPro — cabeceras de caché y compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # CSS, JS, bancos y flujogramas se editan a mano desde el administrador de
  # archivos: el navegador revalida cada vez (304 si no cambió) para que los
  # cambios se vean sin tocar los ?v= de index.html.
  <FilesMatch "\.(css|js|json|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# La llave vive en config.php: nadie debe poder abrirlo desde el navegador
<FilesMatch "^(config\.php|config\.example\.php|\.env|\.env\.example)$">
  Require all denied
</FilesMatch>

# api.php no se cachea nunca
<FilesMatch "^api\.php$">
  Header set Cache-Control "no-store"
</FilesMatch>

Options -Indexes

ErrorDocument 404 /index.html
