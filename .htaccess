# MedQuizPro — cabeceras de caché y compresión
AddType model/gltf-binary .glb

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # CSS, JS, bancos y flujogramas se editan a mano desde el administrador de
  # archivos: el navegador revalida cada vez (304 si no cambió) para que los
  # cambios se vean sin tocar los ?v= de index.html.
  <FilesMatch "\.(css|js|json|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# La llave vive en config.php: nadie debe poder abrirlo desde el navegador
<FilesMatch "^(config\.php|config\.example\.php|\.env|\.env\.example)$">
  Require all denied
</FilesMatch>

# api.php no se cachea nunca
<FilesMatch "^api\.php$">
  Header set Cache-Control "no-store"
</FilesMatch>

Options -Indexes

ErrorDocument 404 /index.html

# cuentas y pagos: nunca se cachea; los datos (cuenta_datos/) no se pueden abrir desde el navegador
<FilesMatch "^cuenta\.php$">
  Header set Cache-Control "no-store"
</FilesMatch>
RedirectMatch 403 ^/cuenta_datos/

# Tutor Feynman IA: las respuestas de la API nunca se cachean
<FilesMatch "^feynman\.php$">
  Header set Cache-Control "no-store"
</FilesMatch>

# Atlas 3D: los fragmentos .dat son datos binarios (gzip) que el visor descomprime él mismo; no deben recomprimirse ni transformarse
<IfModule mod_mime.c>
  AddType application/octet-stream .dat
</IfModule>

# Contenidos protegidos (bancos, flujogramas, casos, guías y PDF): pasan por acceso.php, que los entrega libremente o, con MQP_CERRADO=1,
# solo al dueño y a quien tenga un plan activo. Para comprobar que funciona: con el acceso cerrado, abre /bancos/cardiologia.json en una ventana de incógnito;
# debe mostrar {"ok":false,"acceso":"sin_sesion",...} y no las preguntas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(bancos|flujogramas|herramientas|residentado|guardia|consulta|serums|atlas3d)/(.+)$ acceso.php?f=$1/$2 [L,B]
  RewriteRule ^((guardia_casos|guardia_lab|guardia_biblioteca|guardia_uci|consulta_casos|serums_casos|algoritmos)\.js)$ acceso.php?f=$1 [L,B]
  RewriteRule ^([^/]+\.pdf)$ acceso.php?f=$1 [L,B]
</IfModule>
